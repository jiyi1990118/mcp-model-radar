# Database
DB_TYPE=sqlite
# SQLite: auto-creates at ~/.mcp-model-radar/modelradar.db
# SQLITE_DB_PATH=/custom/path/to/modelradar.db

# PostgreSQL (when DB_TYPE=postgresql)
# DATABASE_URL=postgresql://user:password@localhost:5432/modelradar

# API Keys (optional for V1)
OPENROUTER_API_KEY=

# Collector Settings
HF_COLLECTION_LIMIT=100
HF_PRIORITY_ORGS=unsloth,Qwen,deepseek-ai,microsoft,google,mistralai,meta-llama

# Scheduler
ENABLE_SCHEDULER=false
COLLECTION_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=info
