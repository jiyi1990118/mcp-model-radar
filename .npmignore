# Source files (only ship compiled dist/)
src/
*.ts
!*.d.ts
tsconfig.json

# Development files
.env
.env.example
*.log
.DS_Store

# Git files
.git/
.gitignore
.gitattributes

# Documentation (keep only essential docs defined in package.json files array)
Docs/
docs/
*.md
!README.md
!LICENSE
!MCP_TOOLS.md
!MCP_CONFIG_GUIDE.md

# Test files
test/
tests/
*.test.js
*.spec.js

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
node_modules/
coverage/
.nyc_output/

# Database files (users will create their own)
*.db
*.sqlite
*.sqlite3

# Other
.npmrc
.yarnrc
yarn.lock
pnpm-lock.yaml
